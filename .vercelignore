# Keep Vercel output focused on runtime files.
# Build/API inputs remain in scripts, src, api, db, data and images.

# Local tooling, docs, plans and test artifacts
/.github/
/.impeccable/
/.superpowers/
/.codex-attachments/
/credentials/
/docs/
/experiments/
/plans/
/release/
/tests/
/test-results/
/playwright-report/
/.cache/
/.vercel/
/README.md

# Local-only files and archived/audit source data
.env*
*.zip
*.log
*.lnk
/data/dbd-tracker-*.json
/data/dbd-killer-power-master-*.json
/data/dbd-survivor-perks-live-*.json
/data/killer-perks-audited-*.json

# Original artwork delivery tree: retain only collection portraits used at runtime
/images/updated-images/*
!/images/updated-images/Character Portraits/
/images/updated-images/Character Portraits/*
!/images/updated-images/Character Portraits/Survivors/
/images/updated-images/Character Portraits/Survivors/*
!/images/updated-images/Character Portraits/Survivors/Lore/
/images/updated-images/Character Portraits/Killers/
/images/updated-images/Character Portraits/Killers/*
!/images/updated-images/Character Portraits/Killers/Lore/
/images/missing-perks/
