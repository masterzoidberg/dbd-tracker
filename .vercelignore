# Keep Vercel output focused on runtime files.
# Build/API inputs remain in scripts, src, api, db, data and images.

# Local tooling, docs, plans and test artifacts
/.github/
/.impeccable/
/.superpowers/
/.codex-attachments/
/credentials/
/docs/
/experiments/
/plans/
/release/
/tests/
/test-results/
/playwright-report/
/.cache/
/.vercel/
/README.md

# Local-only files, archives and account exports
.env*
*.zip
*.log
*.lnk
/data/dbd-tracker-*.json

# Keep the runtime character portraits; exclude other source artwork folders
/images/updated-images/*
!/images/updated-images/Character Portraits/
/images/missing-perks/
